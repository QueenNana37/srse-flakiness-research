+package zju.cst.aces.util;
+
+import com.github.javaparser.ast.CompilationUnit;
+
+/**
+ * Chooses which JUnit flavour the generated tests use.
+ * Default is JUnit 5, exactly as before. Run Maven with -Dchatunitest.junit=4
+ * to make ChatUniTest add JUnit 4 + Mockito runner imports instead.
+ */
+public final class JUnitFlavor {
+    private JUnitFlavor() {}
+
+    public static boolean isJUnit4() {
+        return "4".equals(System.getProperty("chatunitest.junit", "5").trim());
+    }
+
+    /** Adds the imports that repairImports always added, in the chosen flavour. */
+    public static void addTestImports(CompilationUnit cu) {
+        if (isJUnit4()) {
+            cu.addImport("org.mockito", false, true);
+            cu.addImport("org.junit.Test");
+            cu.addImport("org.junit.Before");
+            cu.addImport("org.junit.After");
+            cu.addImport("org.junit.Assert");
+            cu.addImport("org.mockito.Mockito", true, true);
+            cu.addImport("org.junit.Assert", true, true);
+            cu.addImport("org.junit.runner.RunWith", false, false);
+            cu.addImport("org.mockito.junit.MockitoJUnitRunner", false, false);
+        } else {
+            cu.addImport("org.mockito", false, true);
+            cu.addImport("org.junit.jupiter.api", false, true);
+            cu.addImport("org.mockito.Mockito", true, true);
+            cu.addImport("org.junit.jupiter.api.Assertions", true, true);
+            cu.addImport("org.junit.jupiter.api.extension.ExtendWith", false, false);
+            cu.addImport("org.mockito.junit.jupiter.MockitoExtension", false, false);
+        }
+    }
+
+    /** The empty test class the generated test methods are put into. */
+    public static String defaultSkeleton() {
+        return isJUnit4()
+                ? "@RunWith(MockitoJUnitRunner.class)\npublic class TestClass {\n}"
+                : "@ExtendWith(MockitoExtension.class)\npublic class TestClass {\n}";
+    }
+}
